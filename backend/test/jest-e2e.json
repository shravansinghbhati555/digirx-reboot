{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.spec.json"
      }
    ]
  },
  "setupFiles": [
    "<rootDir>/e2e-env.ts",
    "<rootDir>/../src/common/test/jest-setup.ts"
  ],
  "testTimeout": 60000,
  "forceExit": true,
  "maxWorkers": 1
}

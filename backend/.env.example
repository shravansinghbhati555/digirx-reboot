PORT=4000
NODE_ENV=development

# Dev-only: allow unsigned x-clinic-id/x-user-id/x-branch-id headers as an
# auth fallback. Must be "true" AND NODE_ENV must not be "production" for
# the fallback to activate. Never enable in production.
ALLOW_DEV_AUTH_HEADERS=true

# MongoDB
# MONGODB_URI=mongodb://root:rootpassword@localhost:27017/digirx?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/digirx

# Redis (later: jobs/notifications)
REDIS_URL=redis://localhost:6379

# S3 / MinIO (documents)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=digirx
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Notifications
# Set to true only when Redis is running (BullMQ worker enabled)
NOTIFICATIONS_QUEUE_ENABLED=false
# Reminder schedule windows in minutes (defaults to 1440,120)
REMINDER_WINDOWS_MINUTES=1440,120
# Which provider sends the actual messages. "console" (default) just logs
# every send to stdout — perfect for dev. "twilio" routes SMS + WhatsApp
# through Twilio and Email through Twilio SendGrid.
NOTIFICATION_PROVIDER=console

# Twilio (SMS + WhatsApp) — required when NOTIFICATION_PROVIDER=twilio and
# the clinic is sending SMS or WhatsApp.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+15551234567
# TWILIO_WHATSAPP_FROM=+15551234567

# Twilio SendGrid (Email) — required when NOTIFICATION_PROVIDER=twilio and
# the clinic is sending Email. EMAIL_FROM must be a verified sender in
# your SendGrid account; EMAIL_FROM_NAME is optional display name.
# SENDGRID_API_KEY=
# EMAIL_FROM=noreply@your-clinic.example
# EMAIL_FROM_NAME=Acme Clinic

# CORS
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Or use a comma-separated allowlist:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://digirx.coderly.in,https://digirx-backend.coderly.in

# Auth (placeholder; rotate in real env)
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=8h
JWT_REFRESH_DAYS=30

# Rate limiting (per-IP)
# Default applies to every route except auth/share which have their own caps.
# Raise THROTTLE_DEFAULT_LIMIT if your client fans out many parallel reads.
THROTTLE_DEFAULT_LIMIT=600
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_SHARE_LIMIT=10
# Set THROTTLE_DISABLED=true to bypass all rate limiting (dev only)
# THROTTLE_DISABLED=false

# PDF fonts (for non-Latin glyphs in prescription / bill PDFs).
# When unset and the default paths are missing, PdfService falls back to
# Helvetica (Latin only). See backend/assets/README.md.
# PDF_FONT_PATH=backend/assets/NotoSans-Regular.ttf
# PDF_FONT_BOLD_PATH=backend/assets/NotoSans-Bold.ttf

# Face recognition (DeepFace sidecar)
# When running outside docker-compose, set this to wherever face-svc is
# reachable from the backend. Inside compose, the default works as-is.
FACE_SVC_URL=http://localhost:8000

# Seed
SEED_ADMIN_PASSWORD=Admin@123


PORT=4000
NODE_ENV=development

# Dev-only: allow unsigned x-clinic-id/x-user-id/x-branch-id headers as an
# auth fallback. Must be "true" AND NODE_ENV must not be "production" for
# the fallback to activate. Never enable in production.
ALLOW_DEV_AUTH_HEADERS=true

# MongoDB
# MONGODB_URI=mongodb://root:rootpassword@localhost:27017/digirx?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/digirx

# Redis (later: jobs/notifications)
REDIS_URL=redis://localhost:6379

# S3 / MinIO (documents)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=digirx
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Notifications
# Set to true only when Redis is running (BullMQ worker enabled)
NOTIFICATIONS_QUEUE_ENABLED=false
# Reminder schedule windows in minutes (defaults to 1440,120)
REMINDER_WINDOWS_MINUTES=1440,120
# Which provider sends the actual messages. "console" (default) just logs
# every send to stdout — perfect for dev. "twilio" routes SMS + WhatsApp
# through Twilio and Email through Twilio SendGrid.
# console = log only (no delivery) | smtp = real email via nodemailer
# twilio = real SMS/WhatsApp/email via Twilio + SendGrid
NOTIFICATION_PROVIDER=console

# SMTP (NOTIFICATION_PROVIDER=smtp) — any mailbox that issues an app password.
# Port 465 uses implicit TLS; 587 starts plain and upgrades with STARTTLS.
# SMTP_SECURE is inferred from the port unless you set it explicitly.
# Gmail: create the app password under Google Account > Security > App passwords
# (requires 2-Step Verification). The 16 characters go in SMTP_PASS, spaces and all.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# EMAIL_FROM defaults to SMTP_USER when unset.

# Twilio (SMS + WhatsApp) — required when NOTIFICATION_PROVIDER=twilio and
# the clinic is sending SMS or WhatsApp.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+15551234567
# TWILIO_WHATSAPP_FROM=+15551234567

# Twilio SendGrid (Email) — required when NOTIFICATION_PROVIDER=twilio and
# the clinic is sending Email. EMAIL_FROM must be a verified sender in
# your SendGrid account; EMAIL_FROM_NAME is optional display name.
# SENDGRID_API_KEY=
# EMAIL_FROM=noreply@your-clinic.example
# EMAIL_FROM_NAME=Acme Clinic

# CORS
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Backend's own externally reachable origin. Used to build the public link
# to invoice/document PDFs (GET /share/:token) when auto-sending invoices to
# patients over WhatsApp/email. Defaults to http://localhost:4000.
PUBLIC_API_URL=http://localhost:4000
# Or use a comma-separated allowlist:
# Every browser origin allowed to call this API: the ERP workspace AND the
# marketing site. A missing entry shows up as a CORS failure on the contact
# form, not as an API error.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://digirx.coderly.in,https://digirx.online,https://www.digirx.online

# Auth (placeholder; rotate in real env)
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=8h
JWT_REFRESH_DAYS=30

# Rate limiting (per-IP)
# Default applies to every route except auth/share which have their own caps.
# Raise THROTTLE_DEFAULT_LIMIT if your client fans out many parallel reads.
THROTTLE_DEFAULT_LIMIT=600
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_SHARE_LIMIT=10
# Set THROTTLE_DISABLED=true to bypass all rate limiting (dev only)
# THROTTLE_DISABLED=false

# PDF fonts (for non-Latin glyphs in prescription / bill PDFs).
# When unset and the default paths are missing, PdfService falls back to
# Helvetica (Latin only). See backend/assets/README.md.
# PDF_FONT_PATH=backend/assets/NotoSans-Regular.ttf
# PDF_FONT_BOLD_PATH=backend/assets/NotoSans-Bold.ttf

# Face recognition — provider switch.
#   local  → OpenCV YuNet+SFace via the face-svc sidecar (default, free)
#   azure  → Azure Face API (cloud; needs Limited Access approval)
# This ONE line flips the whole system between the two backends.
FACE_PROVIDER=local

# --- local provider (face-svc sidecar) ---
# When running outside docker-compose, set this to wherever face-svc is
# reachable from the backend. Inside compose, the default works as-is.
FACE_SVC_URL=http://localhost:8000
# Cosine cutoffs for the SFace gallery search (auto-pick / candidate list).
# FACE_HIGH_THRESHOLD=0.65
# FACE_LOW_THRESHOLD=0.45

# --- azure provider (only used when FACE_PROVIDER=azure) ---
# Identify/Verify are Limited Access — apply via Microsoft's Face form first.
# AZURE_FACE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# AZURE_FACE_KEY=<your-azure-face-key>
# AZURE_FACE_RECOGNITION_MODEL=recognition_04
# AZURE_FACE_DETECTION_MODEL=detection_03
# AZURE_FACE_HIGH_THRESHOLD=0.75
# AZURE_FACE_LOW_THRESHOLD=0.5

# Seed
SEED_ADMIN_PASSWORD=Admin@123


# The platform team's inbox. Receives two things:
#   - website contact-form enquiries (also saved at /platform/leads)
#   - "new clinic awaiting approval" alerts when someone self-registers
# Takes a comma-separated list to copy in more than one person, so a lead is
# not missed while somebody is away:
#   LEADS_NOTIFY_EMAIL=info@digirx.online,raj.baptla@vidhema.com
# Each address gets its own copy, so one bad address does not stop the others.
# Leave unset and both are still recorded, but no email goes out.
# Delivery uses NOTIFICATION_PROVIDER, so real mail needs SENDGRID_API_KEY
# and EMAIL_FROM configured above with NOTIFICATION_PROVIDER=twilio.
LEADS_NOTIFY_EMAIL=info@digirx.online

# Optional logo for the branded emails (registration receipt, clinic
# activated). Must be a publicly reachable absolute URL — mail clients
# cannot load anything behind auth. Unset, the emails use a text wordmark.
# Sign-in and approval-queue links in those emails come from FRONTEND_URL.
# EMAIL_LOGO_URL=https://digirx.online/logo.png

# --- Patient portal (patient.digirx.com) ------------------------------------
# Off unless set to true: every /portal/* route answers 404 and nothing
# changes for the clinic app. Each clinic must also opt in through its
# settings (portal.enabled / portal.bookingEnabled), which default to off.
PATIENT_PORTAL_ENABLED=false
# Signs portal access tokens. Required in production when the portal is on;
# at least 32 characters and different from the staff JWT secrets.
JWT_PORTAL_SECRET=
# PORTAL_ACCESS_TTL=30m
# PORTAL_REFRESH_DAYS=30
# Dial code used for OTP SMS (national numbers are typed in the portal).
# PORTAL_DEFAULT_DIAL_CODE=91
# Add the portal origin to CORS, e.g.:
#   CORS_ORIGINS=https://patient.digirx.com
# (dev: http://localhost:5174)
